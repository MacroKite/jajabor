# MongoDB connection string. Local: mongodb://127.0.0.1:27017/trip
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/trip?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/trip

# Cloudinary, for story photos. Find these on the Cloudinary dashboard (Settings → API Keys).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
